  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "9.35.0",
    "globals": "16.3.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vite": "7.1.7",
    "@playwright/test": "1.55.0"
  }
}
